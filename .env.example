# Copy to ".env" for local dev, or set these as GitHub repo secrets for deployment.
# Leave blank / unset to run FinFlow in local-only mode (no accounts, browser storage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push public key for daily reminders (safe to expose — it ships to the browser).
# Generate with `npx web-push generate-vapid-keys`; put the PRIVATE half in the
# Supabase Edge Function secrets only. Leave blank to disable reminders.
VITE_VAPID_PUBLIC_KEY=
